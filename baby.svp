// A simple test bench for testing the ring out
//
`timescale 1ns/100ps

// A simple interface definition

interface RBUS();
    logic [1:0] Cmd;
    logic [7:0] Data;

    modport rin(input Cmd,input Data);
    modport rout(output Cmd,output Data);

endinterface : RBUS

// For the pins from the timer counter...
interface PPINS();
    logic P1,P2,CE;
    modport ppdevo(output P1, output P2);
    modport ppdevi(input CE);

endinterface : PPINS

interface CLKRESET();
    logic clk;
    logic reset;
    modport clkresi(input clk, input reset);
    modport clkreso(output clk, output reset);
endinterface : CLKRESET


