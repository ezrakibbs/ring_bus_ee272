import uvm_pkg::*;
import comm_defs::*;

module top();


RBUS ringt();
RBUS ringd();
CLKRESET cr() ;
PPINS pps();

// This is UVM stuff for the test bench.
initial begin
    uvm_config_db #(virtual CLKRESET)::set(null,"tb","clkreset",cr);
    uvm_config_db #(virtual RBUS)::set(null,"tb","ringt",ringt); // out of tb
    uvm_config_db #(virtual RBUS)::set(null,"tb","ringd",ringd); // out of device
    uvm_config_db #(virtual RBUS)::set(null,"d0","bin",ringt);
    uvm_config_db #(virtual RBUS)::set(null,"d0","bout",ringd);
    uvm_config_db #(virtual PPINS)::set(null,"d0","pps",pps);
    run_test("t1");
end

// comment out this initial block if you don't want a vcd file.
// The size is limited to 100MB.
initial begin
    $dumpfile("tring.vcd");
    $dumpvars(20,top);
    $dumplimit(1024*1024*100);
end


dd n0(cr.clkresi,ringt.rin,ringd.rout,7'b0,pps.ppdevo,pps.ppdevi);


endmodule : top

// Make a wrapper module matching the block n0 above, and instantiate your
// design in the wrapper. Connect the signals in the interface objects
// to signals to/from your timer design. you can `include your design in the
// wrapper file.
// For the synthesis script, your design must use the 'clk' and 'reset' names.

  `include <dd.sv>


